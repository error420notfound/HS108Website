{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "year": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "brand",
          "product",
          "design-system",
          "mobile",
          "web",
          "strategy",
          "motion"
        ]
      }
    },
    "coverImage": {
      "type": "string"
    },
    "coverAlt": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "contribution": {
      "type": "string"
    },
    "challenge": {
      "type": "string"
    },
    "verification": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          }
        },
        "required": [
          "src",
          "alt"
        ]
      }
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "order": {
      "default": 99,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "client",
    "categories",
    "summary",
    "contribution",
    "challenge",
    "verification"
  ]
}