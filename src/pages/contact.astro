---
import BaseLayout from '@layouts/BaseLayout.astro';

const selectedDomain = Astro.url.searchParams.get('domain') ?? '';
---

<BaseLayout title="Contact" description="Start a project conversation with HS108 by sharing the business problem, uncertainty, and context.">
  <header class="contact-hero container">
    <p class="t-label section-num">Contact</p>
    <div class="contact-hero-grid">
      <h1 class="t-h1">Start with what feels unclear.</h1>
      <p class="t-large">This is not a sales funnel. Share the business context, the symptom, and what decision needs to become clearer.</p>
    </div>
  </header>

  <hr />

  <section class="section container">
    <form class="contact-form" action="mailto:contact.studio@hs108.in" method="post" enctype="text/plain">
      <div class="form-grid">
        <div class="form-group">
          <label class="t-label" for="name">Name</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="form-group">
          <label class="t-label" for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
      </div>

      <div class="form-grid">
        <div class="form-group">
          <label class="t-label" for="business">Business or project</label>
          <input id="business" name="business" type="text" autocomplete="organization" />
        </div>
        <div class="form-group">
          <label class="t-label" for="service">Likely area</label>
          <select id="service" name="service">
            <option value="">Not sure yet</option>
            <option value="webcanvas" selected={selectedDomain === 'webcanvas'}>Reduce purchase friction</option>
            <option value="cx-identity" selected={selectedDomain === 'cx-identity'}>Improve positioning</option>
            <option value="cmf-nexus" selected={selectedDomain === 'cmf-nexus'}>Build market confidence</option>
            <option value="lumina-raw" selected={selectedDomain === 'lumina-raw'}>Clarify visual evidence</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="t-label" for="trying">What are you trying to build or improve?</label>
        <textarea id="trying" name="trying_to_build" rows="5" required></textarea>
      </div>

      <div class="form-group">
        <label class="t-label" for="unclear">What feels unclear right now?</label>
        <textarea id="unclear" name="what_feels_unclear" rows="5" required></textarea>
      </div>

      <div class="form-grid">
        <div class="form-group">
          <label class="t-label" for="timeline">Timeline</label>
          <select id="timeline" name="timeline">
            <option value="">Not fixed</option>
            <option>Next 4 weeks</option>
            <option>1-3 months</option>
            <option>3-6 months</option>
            <option>Exploratory</option>
          </select>
        </div>
        <div class="form-group">
          <label class="t-label" for="budget">Budget range</label>
          <select id="budget" name="budget_range">
            <option value="">Prefer to discuss</option>
            <option>Under 2L INR</option>
            <option>2L-5L INR</option>
            <option>5L-10L INR</option>
            <option>10L+ INR</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="t-label" for="found">How did you find HS108?</label>
        <input id="found" name="how_found" type="text" />
      </div>

      <div class="contact-actions">
        <button type="submit" class="btn btn--primary">Send Project Context</button>
        <a href="mailto:contact.studio@hs108.in" class="btn btn--outline">Email Directly</a>
      </div>
    </form>

    <aside class="contact-note">
      <p class="t-label">What happens next</p>
      <ol>
        <li class="t-body">HS108 reviews the business context.</li>
        <li class="t-body">If the problem appears aligned, we suggest the next useful conversation.</li>
        <li class="t-body">If it is not a fit, we say so clearly.</li>
      </ol>
    </aside>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    padding-block: var(--space-96) var(--space-64);
  }

  .contact-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.7fr);
    gap: var(--space-64);
    align-items: end;
    margin-top: var(--space-16);
  }

  .contact-hero h1 {
    max-width: 10ch;
  }

  .contact-hero p:last-child {
    color: var(--text-muted);
  }

  .section.container {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: var(--space-64);
    align-items: start;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-24);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .form-group label {
    color: var(--text-muted);
  }

  input,
  textarea,
  select {
    width: 100%;
    min-height: 44px;
    padding: var(--space-12);
    border: var(--border-width) solid var(--border);
    background: var(--surface-elevated);
    color: var(--fg);
    border-radius: 0;
  }

  textarea {
    resize: vertical;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
  }

  .contact-note {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-24));
    padding: var(--space-card);
    border: var(--border-width) solid var(--border);
    background: var(--surface-elevated);
  }

  .contact-note .t-label {
    margin-bottom: var(--space-16);
    color: var(--text-muted);
  }

  .contact-note ol {
    display: grid;
    gap: var(--space-12);
    counter-reset: steps;
  }

  .contact-note li {
    counter-increment: steps;
    color: var(--text-muted);
  }

  .contact-note li::before {
    content: counter(steps, decimal-leading-zero) ". ";
    font-family: var(--font-mono);
    font-size: var(--size-label);
  }

  @media (max-width: 900px) {
    .contact-hero-grid,
    .section.container,
    .form-grid {
      grid-template-columns: 1fr;
    }

    .contact-note {
      position: static;
    }
  }
</style>
