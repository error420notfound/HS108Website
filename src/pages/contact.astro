---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="Start a Project" description="Tell HS108 what you are trying to solve across brand, product, or digital design.">
  <header class="page-hero shell"><p class="eyebrow">Start a conversation</p><h1 class="display">Tell us what needs to change.</h1><p class="lead">A useful first note explains the challenge, where you are now, and what you hope design can help decide. You do not need to choose a service or package first.</p><div class="hero-actions"><a class="button button--primary" href="#enquiry-form">Write your brief ↓</a></div></header>
  <div class="shell contact-grid">
    <aside class="contact-explain"><p class="eyebrow">A good starting point</p><h2>What are you trying to solve?</h2><p>Share enough context for a focused conversation: the company or project, the people it serves, the obstacle, and any relevant timing. The scope can be defined together.</p><p>This form opens a draft in your email app. Review it and send it from there. No payment or booking is required to make an enquiry.</p><a class="text-link" href="mailto:contact.studio@hs108.in">Or email contact.studio@hs108.in ↗</a></aside>
    <form class="contact-form" id="enquiry-form" action="mailto:contact.studio@hs108.in" method="post" enctype="text/plain">
      <div class="form-grid">
        <div class="form-field"><label for="contact-name">Name <span aria-hidden="true">*</span></label><input id="contact-name" name="name" autocomplete="name" required aria-describedby="name-error" /><span class="form-help" id="name-error" hidden>Please enter your name.</span></div>
        <div class="form-field"><label for="contact-email">Email <span aria-hidden="true">*</span></label><input id="contact-email" name="email" type="email" autocomplete="email" required aria-describedby="email-error" /><span class="form-help" id="email-error" hidden>Please enter a valid email address.</span></div>
        <div class="form-field form-field--full"><label for="contact-project">Company or project <span aria-hidden="true">*</span></label><input id="contact-project" name="project" autocomplete="organization" required aria-describedby="project-error" /><span class="form-help" id="project-error" hidden>Please enter a company or project name.</span></div>
        <div class="form-field form-field--full"><label for="contact-challenge">What are you trying to solve? <span aria-hidden="true">*</span></label><textarea id="contact-challenge" name="challenge" required aria-describedby="challenge-error" placeholder="Tell us about the offer, audience, and decision you are facing."></textarea><span class="form-help" id="challenge-error" hidden>Please tell us about the challenge.</span></div>
        <div class="form-field form-field--full"><label for="contact-timeframe">Desired timeframe <span class="form-help">(optional)</span></label><input id="contact-timeframe" name="timeframe" placeholder="For example, a launch date or an open-ended exploration" /></div>
      </div>
      <div class="form-actions"><button type="submit" class="button button--primary">Open email draft <span aria-hidden="true">↗</span></button><p class="form-status" id="form-status" role="status" aria-live="polite" hidden></p></div>
    </form>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#enquiry-form');
  const status = document.querySelector<HTMLElement>('#form-status');
  if (form) {
    form.addEventListener('invalid', (event) => {
      const field = event.target as HTMLInputElement | HTMLTextAreaElement;
      field.setAttribute('aria-invalid', 'true');
      const error = document.getElementById(`${field.id.replace('contact-', '')}-error`);
      if (error) error.hidden = false;
    }, true);
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach(field => {
      field.addEventListener('input', () => {
        if (field.validity.valid) {
          field.removeAttribute('aria-invalid');
          const error = document.getElementById(`${field.id.replace('contact-', '')}-error`);
          if (error) error.hidden = true;
        }
      });
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const project = String(data.get('project') ?? '').trim();
      const subject = `Project enquiry — ${project}`;
      const body = [
        `Name: ${String(data.get('name') ?? '').trim()}`,
        `Email: ${String(data.get('email') ?? '').trim()}`,
        `Company or project: ${project}`,
        `Desired timeframe: ${String(data.get('timeframe') ?? '').trim() || 'Not specified'}`,
        '',
        'What we are trying to solve:',
        String(data.get('challenge') ?? '').trim(),
      ].join('\n');
      if (status) {
        status.textContent = 'Your email app should open with the draft. Review it and select Send there. If it does not open, email contact.studio@hs108.in directly.';
        status.hidden = false;
      }
      window.location.href = `mailto:contact.studio@hs108.in?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  }
</script>
