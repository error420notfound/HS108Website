---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactCTA from '@components/ContactCTA.astro';
const reasons = [
  { title: 'Cross-disciplinary judgment', body: 'HS108 can consider what a decision means for an identity, a physical product, and a digital experience at the same time.' },
  { title: 'Senior-led direction', body: 'The studio is led by senior designers, bringing experienced judgment to the questions behind the output.' },
  { title: 'Business-aware framing', body: 'The discussion starts with the offer, audience, and operational realities that design needs to support.' },
  { title: 'Systems over isolated artifacts', body: 'The goal is a coherent set of principles and outputs that teams can put to work together.' },
  { title: 'Implementation in view', body: 'Handoff and practical use matter, whether the work becomes packaging, a product, a website, or a design system.' },
];
---
<BaseLayout title="Why HS108" description="Why a connected approach to brand, product, and digital design can help a business make clearer decisions.">
  <header class="page-hero shell"><p class="eyebrow">Why HS108</p><h1 class="display">One partner for connected design decisions.</h1><p class="lead">The advantage of a cross-disciplinary studio is perspective: a decision made in one part of the business can be understood in relation to the others.</p></header>
  <section class="section shell" aria-labelledby="reasons-title"><div class="section-head"><p class="eyebrow">The working difference</p><div><h2 class="section-title" id="reasons-title">What this approach makes possible.</h2><p>These are proposed descriptions of HS108's practice; specific operating commitments should be confirmed with the studio before publication as guarantees.</p></div></div><div class="row-list">{reasons.map((r,i) => <div class="row-item"><span class="row-num">0{i+1}</span><h3 class="row-title">{r.title}</h3><p class="row-desc">{r.body}</p><span></span></div>)}</div></section>
  <ContactCTA headline="See whether the fit is right." sub="A short first conversation can clarify the problem, the relevant disciplines, and the best next step." />
</BaseLayout>
