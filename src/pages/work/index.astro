---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactCTA from '@components/ContactCTA.astro';
import { getCollection } from 'astro:content';
const entries = (await getCollection('work', ({ data }) => !data.draft)).sort((a,b) => a.data.order-b.data.order);
---
<BaseLayout title="Work" description="Explore the HS108 studio archive across brand, product, and digital design. Case study details are being confirmed.">
  <header class="page-hero shell"><p class="eyebrow">Selected work / archive under review</p><h1 class="display">The work behind<br /> <em>the thinking.</em></h1><p class="lead">These case studies come from the existing studio archive. Client relationships, project scope, dates, and outcomes are being confirmed before they are used as client proof.</p></header>
  <section class="section shell work-list" aria-label="Archive case studies">
    {entries.map(entry => <article class="work-feature"><a class="work-visual work-visual--missing" href={`/work/${entry.id}`} aria-label={`View ${entry.data.title} archive record`}><span>{entry.data.title}</span><small>Archive record / project artifacts pending confirmation</small></a><div class="work-feature-copy"><p class="archive-label">Archive record / details require confirmation</p><h2 class="row-title">{entry.data.title}</h2><p class="meta">{entry.data.categories.join(' / ')}</p><p>{entry.data.summary}</p><a class="text-link" href={`/work/${entry.id}`}>Read the archive case study ↗</a></div></article>)}
  </section>
  <ContactCTA />
</BaseLayout>
