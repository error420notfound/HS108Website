---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/SectionHeader.astro';
import WorkCard from '@components/WorkCard.astro';
import ContactCTA from '@components/ContactCTA.astro';
import { getCollection } from 'astro:content';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Work" description="Selected HS108 projects shown as evidence of diagnosis, decision-making, and execution.">
  <header class="work-hero container">
    <p class="t-label section-num">Work</p>
    <div class="work-hero-grid">
      <h1 class="t-h1">Projects are evidence of thinking.</h1>
      <p class="t-large">Work is not presented as a gallery. Each project shows the business challenge, the diagnosis, the design intervention, and what became clearer.</p>
    </div>
  </header>

  <hr />

  <section class="section container">
    <SectionHeader
      label="Selected Evidence"
      title="Read the diagnosis before the outcome."
      intro="Images remain available as proof of execution, but the project is organized around the business decision it helped clarify."
    />
    <div class="work-list">
      {work.map(entry => (
        <WorkCard
          slug={entry.slug}
          title={entry.data.title}
          client={entry.data.client}
          year={entry.data.year}
          categories={entry.data.categories}
          summary={entry.data.summary}
          outcome={entry.data.outcome}
          businessChallenge={entry.data.businessChallenge}
          diagnosis={entry.data.diagnosis}
          coverImage={entry.data.coverImage}
          coverAlt={entry.data.coverAlt}
          large
        />
      ))}
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .work-hero {
    padding-block: var(--space-96) var(--space-64);
  }

  .work-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.7fr);
    gap: var(--space-64);
    align-items: end;
    margin-top: var(--space-16);
  }

  .work-hero h1 {
    max-width: 12ch;
  }

  .work-hero p:last-child {
    color: var(--text-muted);
  }

  .work-list {
    display: grid;
    gap: var(--space-gap);
  }

  @media (max-width: 800px) {
    .work-hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
