---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/SectionHeader.astro';
import DecisionMatrix from '@components/DecisionMatrix.astro';
import RelatedContent from '@components/RelatedContent.astro';
import ContactCTA from '@components/ContactCTA.astro';

const matrix = [
  {
    signal: 'The product is technically strong but hard to evaluate',
    diagnosis: 'Buyers cannot read quality, use, or intent before purchase.',
    designResponse: 'Clarify material, form, finish, use context, and proof.',
  },
  {
    signal: 'The product feels disconnected from the brand',
    diagnosis: 'Product decisions and brand decisions are not governed by the same logic.',
    designResponse: 'Align CMF, product expression, packaging, and communication.',
  },
  {
    signal: 'Manufacturing constraints dilute the design',
    diagnosis: 'Execution constraints were not part of the design decision early enough.',
    designResponse: 'Build a product direction that respects production reality.',
  },
];
---

<BaseLayout title="Build Market Confidence" description="CMF Nexus helps products communicate quality, fit, and confidence before purchase.">
  <header class="service-hero container">
    <p class="t-label section-num">Service Path / CMF Nexus</p>
    <div class="service-hero-grid">
      <h1 class="t-h1">Build market confidence.</h1>
      <p class="t-large">For physical or product-led businesses where form, material, finish, and communication must support the same purchase decision.</p>
    </div>
  </header>
  <hr />
  <section class="section container">
    <SectionHeader label="Diagnosis" title="Product design should make quality easier to judge." intro="The work connects market perception with product reality, not isolated styling." />
    <DecisionMatrix rows={matrix} />
  </section>
  <section class="section section--muted">
    <div class="container">
      <SectionHeader label="System" title="What the engagement produces." intro="Outputs depend on whether the blocker is perception, product logic, or production readiness." />
      <div class="grid-3">
        {['Product direction and concept logic', 'CMF recommendations', 'Prototype and production guidance', 'Packaging and presentation systems', 'Launch evidence and product story', 'Decision documentation'].map(item => (
          <div class="deliverable"><p class="t-body">{item}</p></div>
        ))}
      </div>
    </div>
  </section>
  <section class="section container">
    <RelatedContent title="Related Thinking" items={[{ label: 'Field Note', title: 'Why Premium Products Fail To Feel Premium', href: '/thinking/why-premium-products-fail-to-feel-premium' }]} />
  </section>
  <ContactCTA domain="cmf-nexus" />
</BaseLayout>

<style>
  .service-hero { padding-block: var(--space-96) var(--space-64); }
  .service-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, 0.7fr); gap: var(--space-64); align-items: end; margin-top: var(--space-16); }
  .service-hero h1 { max-width: 10ch; }
  .service-hero p:last-child { color: var(--text-muted); }
  .deliverable { padding: var(--space-card); border: var(--border-width) solid var(--border); background: var(--surface-elevated); }
  .deliverable p { color: var(--text-muted); }
  @media (max-width: 800px) { .service-hero-grid { grid-template-columns: 1fr; } }
</style>
