---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/SectionHeader.astro';
import DecisionMatrix from '@components/DecisionMatrix.astro';
import RelatedContent from '@components/RelatedContent.astro';
import ContactCTA from '@components/ContactCTA.astro';

const matrix = [
  {
    signal: 'People cannot explain what makes the business different',
    diagnosis: 'Positioning is not specific enough to guide memory or choice.',
    designResponse: 'Clarify category, audience, difference, and proof.',
  },
  {
    signal: 'The business has outgrown its identity',
    diagnosis: 'The current system no longer reflects operational maturity.',
    designResponse: 'Build identity rules that communicate confidence and scale without exaggeration.',
  },
  {
    signal: 'Teams communicate the offer differently',
    diagnosis: 'Brand decisions are being made without shared language or governance.',
    designResponse: 'Create messaging, visual rules, and usage guidance.',
  },
];
---

<BaseLayout title="Improve Positioning" description="CX & Identity helps businesses make value, difference, and trust easier to understand.">
  <header class="service-hero container">
    <p class="t-label section-num">Service Path / CX & Identity</p>
    <div class="service-hero-grid">
      <h1 class="t-h1">Improve positioning.</h1>
      <p class="t-large">For businesses whose value is real, but not yet clear enough for customers, teams, or markets to act on confidently.</p>
    </div>
  </header>
  <hr />
  <section class="section container">
    <SectionHeader label="Diagnosis" title="Identity should clarify why the business deserves attention." intro="The work starts with what needs to become easier to understand, not with a logo request." />
    <DecisionMatrix rows={matrix} />
  </section>
  <section class="section section--muted">
    <div class="container">
      <SectionHeader label="System" title="What the engagement produces." intro="The output is a coherent positioning and identity system that can guide repeated decisions." />
      <div class="grid-3">
        {['Positioning and value hierarchy', 'Messaging architecture', 'Identity system and visual language', 'Guidelines and governance rules', 'Launch and communication assets', 'Internal usage documentation'].map(item => (
          <div class="deliverable"><p class="t-body">{item}</p></div>
        ))}
      </div>
    </div>
  </section>
  <section class="section container">
    <RelatedContent title="Related Work" items={[{ label: 'Work', title: 'NovaPay Fintech Rebrand', href: '/work/novapay' }]} />
  </section>
  <ContactCTA domain="cx-identity" />
</BaseLayout>

<style>
  .service-hero { padding-block: var(--space-96) var(--space-64); }
  .service-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, 0.7fr); gap: var(--space-64); align-items: end; margin-top: var(--space-16); }
  .service-hero h1 { max-width: 10ch; }
  .service-hero p:last-child { color: var(--text-muted); }
  .deliverable { padding: var(--space-card); border: var(--border-width) solid var(--border); background: var(--surface-elevated); }
  .deliverable p { color: var(--text-muted); }
  @media (max-width: 800px) { .service-hero-grid { grid-template-columns: 1fr; } }
</style>
