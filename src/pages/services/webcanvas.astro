---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/SectionHeader.astro';
import DecisionMatrix from '@components/DecisionMatrix.astro';
import RelatedContent from '@components/RelatedContent.astro';
import ContactCTA from '@components/ContactCTA.astro';

const matrix = [
  {
    signal: 'Visitors understand the offer too slowly',
    diagnosis: 'The site is presenting information in the wrong order.',
    designResponse: 'Rebuild the information architecture around the customer decision.',
  },
  {
    signal: 'Users drop from key product flows',
    diagnosis: 'Interface friction is hiding the next useful action.',
    designResponse: 'Clarify states, feedback, hierarchy, and task sequence.',
  },
  {
    signal: 'Teams keep redesigning pages ad hoc',
    diagnosis: 'There is no shared digital system for recurring decisions.',
    designResponse: 'Create reusable patterns, content rules, and handoff documentation.',
  },
];
---

<BaseLayout title="Reduce Purchase Friction" description="WebCanvas helps businesses reduce purchase and adoption friction through clearer digital experiences.">
  <header class="service-hero container">
    <p class="t-label section-num">Service Path / WebCanvas</p>
    <div class="service-hero-grid">
      <h1 class="t-h1">Reduce purchase friction.</h1>
      <p class="t-large">For websites, product interfaces, and digital journeys where interest exists but understanding breaks before action.</p>
    </div>
  </header>
  <hr />
  <section class="section container">
    <SectionHeader label="Diagnosis" title="Digital design begins with the decision path." intro="The question is not only what screen to design. The question is what a customer needs to understand before they can move forward." />
    <DecisionMatrix rows={matrix} />
  </section>
  <section class="section section--muted">
    <div class="container">
      <SectionHeader label="System" title="What the engagement produces." intro="Deliverables are selected after the friction is diagnosed." />
      <div class="grid-3">
        {['Information architecture and page strategy', 'Website or product interface design', 'Prototype and state documentation', 'Design tokens and component rules', 'Developer handoff and QA support', 'Conversion path recommendations'].map(item => (
          <div class="deliverable"><p class="t-body">{item}</p></div>
        ))}
      </div>
    </div>
  </section>
  <section class="section container">
    <RelatedContent title="Related Thinking" items={[{ label: 'Field Note', title: 'Why Good Products Become Hard To Trust', href: '/thinking/why-good-products-become-hard-to-trust' }]} />
  </section>
  <ContactCTA domain="webcanvas" />
</BaseLayout>

<style>
  .service-hero { padding-block: var(--space-96) var(--space-64); }
  .service-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, 0.7fr); gap: var(--space-64); align-items: end; margin-top: var(--space-16); }
  .service-hero h1 { max-width: 10ch; }
  .service-hero p:last-child { color: var(--text-muted); }
  .deliverable { padding: var(--space-card); border: var(--border-width) solid var(--border); background: var(--surface-elevated); }
  .deliverable p { color: var(--text-muted); }
  @media (max-width: 800px) { .service-hero-grid { grid-template-columns: 1fr; } }
</style>
