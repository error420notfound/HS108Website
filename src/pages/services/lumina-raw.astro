---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/SectionHeader.astro';
import DecisionMatrix from '@components/DecisionMatrix.astro';
import RelatedContent from '@components/RelatedContent.astro';
import ContactCTA from '@components/ContactCTA.astro';

const matrix = [
  {
    signal: 'Images look good but do not change understanding',
    diagnosis: 'The visual system is decorative instead of evidential.',
    designResponse: 'Define what each image must prove before production begins.',
  },
  {
    signal: 'Launch assets feel disconnected',
    diagnosis: 'Content is being made by format, not by decision role.',
    designResponse: 'Build a visual evidence system across channels.',
  },
  {
    signal: 'The product story depends on explanation elsewhere',
    diagnosis: 'The image set does not communicate use, quality, or context alone.',
    designResponse: 'Create visual sequences that teach before they promote.',
  },
];
---

<BaseLayout title="Clarify Visual Evidence" description="Lumina Raw creates photography and motion systems that explain value rather than decorate surfaces.">
  <header class="service-hero container">
    <p class="t-label section-num">Service Path / Lumina Raw</p>
    <div class="service-hero-grid">
      <h1 class="t-h1">Clarify visual evidence.</h1>
      <p class="t-large">For businesses that need images, motion, and visual documentation to explain value, quality, process, and context.</p>
    </div>
  </header>
  <hr />
  <section class="section container">
    <SectionHeader label="Diagnosis" title="Visual content should carry proof." intro="The question is not how to make content more eye-catching. It is what the content needs to help someone understand." />
    <DecisionMatrix rows={matrix} />
  </section>
  <section class="section section--muted">
    <div class="container">
      <SectionHeader label="System" title="What the engagement produces." intro="The output is a useful visual evidence system, not filler for weak pages." />
      <div class="grid-3">
        {['Product and process photography', 'Campaign image systems', 'Motion and launch assets', 'Visual sequencing and usage rules', 'Editing and production standards', 'Caption and evidence guidance'].map(item => (
          <div class="deliverable"><p class="t-body">{item}</p></div>
        ))}
      </div>
    </div>
  </section>
  <section class="section container">
    <RelatedContent title="Related Framework" items={[{ label: 'Framework', title: 'SIAM', href: '/frameworks/siam' }]} />
  </section>
  <ContactCTA domain="lumina-raw" />
</BaseLayout>

<style>
  .service-hero { padding-block: var(--space-96) var(--space-64); }
  .service-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, 0.7fr); gap: var(--space-64); align-items: end; margin-top: var(--space-16); }
  .service-hero h1 { max-width: 10ch; }
  .service-hero p:last-child { color: var(--text-muted); }
  .deliverable { padding: var(--space-card); border: var(--border-width) solid var(--border); background: var(--surface-elevated); }
  .deliverable p { color: var(--text-muted); }
  @media (max-width: 800px) { .service-hero-grid { grid-template-columns: 1fr; } }
</style>
