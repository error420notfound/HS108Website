---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import SectionHeader from '@components/SectionHeader.astro';
import ProblemList from '@components/ProblemList.astro';
import DecisionMatrix from '@components/DecisionMatrix.astro';
import InsightCard from '@components/InsightCard.astro';
import FrameworkCard from '@components/FrameworkCard.astro';
import WorkCard from '@components/WorkCard.astro';
import ContactCTA from '@components/ContactCTA.astro';
import { getCollection } from 'astro:content';

const work = (await getCollection('work', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const thinking = (await getCollection('thinking', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const frameworks = (await getCollection('frameworks'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const problems = [
  {
    symptom: 'Customers understand the product too late.',
    cause: 'The value is present, but the path to understanding is not structured clearly enough.',
  },
  {
    symptom: 'The business looks less mature than it is.',
    cause: 'The design system is not carrying the credibility already present in operations, product, or service quality.',
  },
  {
    symptom: 'Growth creates inconsistency.',
    cause: 'More people are making design decisions without a shared governance model.',
  },
  {
    symptom: 'The team keeps asking for deliverables.',
    cause: 'The deeper business problem has not been diagnosed before design work begins.',
  },
];

const matrix = [
  {
    signal: 'Low conversion with high interest',
    diagnosis: 'The offer may be attractive but the decision path creates doubt.',
    designResponse: 'Clarify proof, sequence, comparison, and next action.',
  },
  {
    signal: 'Premium product, weak perceived value',
    diagnosis: 'The interface relies on aesthetics more than evidence.',
    designResponse: 'Expose quality, constraints, process, and buyer fit.',
  },
  {
    signal: 'Inconsistent product experience',
    diagnosis: 'Design decisions are being made locally without governance.',
    designResponse: 'Create rules, patterns, and ownership paths.',
  },
];

const services = [
  {
    title: 'Improve Positioning',
    problem: 'The business is valuable, but customers cannot quickly understand why it matters.',
    href: '/services/cx-identity',
  },
  {
    title: 'Reduce Purchase Friction',
    problem: 'People are interested, but uncertainty interrupts the path to enquiry, purchase, or adoption.',
    href: '/services/webcanvas',
  },
  {
    title: 'Build Market Confidence',
    problem: 'The product or experience needs to justify trust before the customer commits.',
    href: '/services/cmf-nexus',
  },
];
---

<BaseLayout title="Business clarity through design" description="HS108 helps founders understand business challenges and use design to make better decisions.">
  <Hero />

  <section class="section container">
    <SectionHeader
      label="Business Problems"
      title="Founders rarely arrive with design problems first."
      intro="They arrive with symptoms: low trust, unclear value, weak conversion, fragmented teams, or a product that is harder to sell than it should be."
    />
    <ProblemList items={problems} />
  </section>

  <section class="section section--muted">
    <div class="container">
      <SectionHeader
        label="What Design Actually Solves"
        title="Design is useful when it clarifies the decision underneath the symptom."
        intro="The work begins by separating what is visible from what is causing the business problem."
      />
      <DecisionMatrix rows={matrix} />
    </div>
  </section>

  <section class="section container">
    <SectionHeader
      label="Selected Thinking"
      title="The thinking is primary."
      intro="Field notes make the diagnostic logic visible before a project conversation begins."
    />
    <div class="grid-3">
      {thinking.map(entry => (
        <InsightCard
          label={entry.data.category}
          title={entry.data.title}
          observation={entry.data.summary}
          implication={entry.data.question}
          href={`/thinking/${entry.slug}`}
        />
      ))}
    </div>
  </section>

  <section class="section container">
    <SectionHeader
      label="Frameworks"
      title="Reusable systems for better decisions."
      intro="Frameworks turn HS108's thinking into practical tools for diagnosing ambiguity and choosing the right intervention."
    />
    <div class="grid-2">
      {frameworks.map(entry => (
        <FrameworkCard
          title={entry.data.title}
          helps={entry.data.helps}
          applies={entry.data.applies}
          href={`/frameworks/${entry.slug}`}
        />
      ))}
    </div>
  </section>

  <section class="section container">
    <SectionHeader
      label="Selected Work"
      title="Projects are evidence."
      intro="Work appears after the thinking because execution should prove the diagnosis, not replace it."
    />
    <div class="work-grid">
      {work.map((entry, index) => (
        <WorkCard
          slug={entry.slug}
          title={entry.data.title}
          client={entry.data.client}
          year={entry.data.year}
          categories={entry.data.categories}
          summary={entry.data.summary}
          outcome={entry.data.outcome}
          businessChallenge={entry.data.businessChallenge}
          diagnosis={entry.data.diagnosis}
          coverImage={entry.data.coverImage}
          coverAlt={entry.data.coverAlt}
          large={index === 0}
        />
      ))}
    </div>
    <div class="section-action">
      <a href="/work" class="btn btn--outline">Review Selected Work</a>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <SectionHeader
        label="Services"
        title="Engagements are framed around outcomes."
        intro="HS108 does not begin by selling deliverables. It begins by understanding what needs to become clearer for the business."
      />
      <div class="grid-3">
        {services.map(service => (
          <a href={service.href} class="service-card">
            <p class="t-label">Service Path</p>
            <h3 class="t-h3">{service.title}</h3>
            <p class="t-body">{service.problem}</p>
            <span class="t-label">See How The System Works</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-gap);
  }

  .work-grid > :first-child {
    grid-column: 1 / -1;
  }

  .section-action {
    margin-top: var(--space-32);
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    min-height: 100%;
    padding: var(--space-card);
    border: var(--border-width) solid var(--border);
    background: var(--surface-elevated);
  }

  .service-card:hover {
    background: var(--surface-base);
  }

  .service-card .t-label,
  .service-card p {
    color: var(--text-muted);
  }

  .service-card span {
    margin-top: auto;
  }

  @media (max-width: 900px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
