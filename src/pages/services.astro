---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/SectionHeader.astro';
import ContactCTA from '@components/ContactCTA.astro';

const services = [
  {
    title: 'Improve Positioning',
    label: 'CX & Identity',
    href: '/services/cx-identity',
    problem: 'The business is valuable, but the market cannot quickly understand why it should care.',
    diagnosis: 'Value is often present before it is legible. The work is to make difference, trust, and fit easier to understand.',
    output: 'Positioning, identity, messaging hierarchy, and brand governance.',
  },
  {
    title: 'Reduce Purchase Friction',
    label: 'WebCanvas',
    href: '/services/webcanvas',
    problem: 'Customers show interest, but uncertainty interrupts the path to enquiry, purchase, or adoption.',
    diagnosis: 'Most digital friction is an information problem before it is an interface problem.',
    output: 'Website, product interface, information architecture, and conversion path design.',
  },
  {
    title: 'Build Market Confidence',
    label: 'CMF Nexus',
    href: '/services/cmf-nexus',
    problem: 'A product needs to justify trust, quality, and purchase intent before people experience it physically.',
    diagnosis: 'Material, form, finish, and product storytelling must support the same market decision.',
    output: 'Product direction, CMF, prototyping guidance, and launch-ready product communication.',
  },
  {
    title: 'Clarify Visual Evidence',
    label: 'Lumina Raw',
    href: '/services/lumina-raw',
    problem: 'The business needs proof, but its images and motion do not explain the value clearly enough.',
    diagnosis: 'Visual content should carry evidence, not fill space or chase attention.',
    output: 'Product photography, campaign systems, visual documentation, and launch assets.',
  },
];
---

<BaseLayout title="Services" description="Outcome-oriented HS108 services for improving positioning, reducing friction, and building market confidence.">
  <header class="services-hero container">
    <p class="t-label section-num">Services</p>
    <div class="services-hero-grid">
      <h1 class="t-h1">Engagements begin with the business problem.</h1>
      <p class="t-large">HS108 services translate diagnosis into the right design intervention. Deliverables matter, but only after the problem is understood.</p>
    </div>
  </header>

  <hr />

  <section class="section container">
    <SectionHeader
      label="Service Paths"
      title="Choose by outcome, not by deliverable."
      intro="Each path explains the problem, the likely diagnosis, and what changes when the system works."
    />
    <div class="service-list">
      {services.map((service, index) => (
        <a href={service.href} class="service-row">
          <span class="t-label service-index">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <p class="t-label service-label">{service.label}</p>
            <h2 class="t-h3">{service.title}</h2>
          </div>
          <p class="t-body">{service.problem}</p>
          <p class="t-body">{service.diagnosis}</p>
          <span class="t-label">See How The System Works</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <SectionHeader
        label="How Engagements Are Scoped"
        title="Diagnosis determines the work."
        intro="A project may involve identity, product, digital, or content systems. The engagement is shaped by what must become clearer for the business."
      />
      <div class="grid-3">
        {[
          ['Problem', 'What symptom is visible in the business right now?'],
          ['Diagnosis', 'What is causing the symptom beneath the design surface?'],
          ['System', 'What repeatable structure will help people make better decisions?'],
        ].map(([title, body]) => (
          <article class="scope-card">
            <p class="t-label">{title}</p>
            <p class="t-body">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .services-hero {
    padding-block: var(--space-96) var(--space-64);
  }

  .services-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.7fr);
    gap: var(--space-64);
    align-items: end;
    margin-top: var(--space-16);
  }

  .services-hero h1 {
    max-width: 12ch;
  }

  .services-hero p:last-child {
    color: var(--text-muted);
  }

  .service-list {
    border-top: var(--border-width) solid var(--border);
  }

  .service-row {
    display: grid;
    grid-template-columns: 64px minmax(180px, 0.7fr) minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: var(--space-24);
    align-items: start;
    padding-block: var(--space-24);
    border-bottom: var(--border-width) solid var(--border);
  }

  .service-row:hover {
    background: var(--surface-muted);
  }

  .service-index,
  .service-label,
  .service-row p,
  .scope-card .t-label,
  .scope-card p {
    color: var(--text-muted);
  }

  .scope-card {
    min-height: 100%;
    padding: var(--space-card);
    border: var(--border-width) solid var(--border);
    background: var(--surface-elevated);
  }

  .scope-card .t-label {
    margin-bottom: var(--space-16);
  }

  @media (max-width: 1100px) {
    .service-row {
      grid-template-columns: 48px 1fr;
    }

    .service-row > *:nth-child(n + 3) {
      grid-column: 2;
    }
  }

  @media (max-width: 760px) {
    .services-hero-grid,
    .service-row {
      grid-template-columns: 1fr;
    }

    .service-row > *:nth-child(n + 3) {
      grid-column: auto;
    }
  }
</style>
