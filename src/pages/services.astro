---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactCTA from '@components/ContactCTA.astro';
import { capabilities } from '../data/site';
---
<BaseLayout title="Capabilities" description="HS108 connects brand systems, industrial product design, digital experiences, and visual content around business decisions.">
  <header class="page-hero shell"><p class="eyebrow">What we do</p><h1 class="display">Capabilities that<br /> <em>work together.</em></h1><p class="lead">Brand gives an offer meaning. Product makes it useful and real. Digital makes it understandable and usable. Visual content helps people see the whole. We choose the right combination for the problem.</p><div class="hero-actions"><a href="/contact" class="button button--primary">Discuss a project ↗</a></div></header>
  <section class="section shell" aria-labelledby="capabilities-list-title"><div class="section-head"><p class="eyebrow">Capabilities</p><div><h2 class="section-title" id="capabilities-list-title">Start with the decision you need to make.</h2><p>A scope may stay within one discipline or connect several. The work begins by defining what needs to change.</p></div></div><div class="row-list">{capabilities.map((c,i) => <a class="row-link" href={c.href}><span class="row-num">0{i+1}</span><span class="row-title">{c.name}</span><span class="row-desc">{c.intro}<br />{c.situation}</span><span class="row-arrow" aria-hidden="true">↗</span></a>)}</div></section>
  <section class="section dark" aria-labelledby="governance-title"><div class="shell approach-split"><div><p class="eyebrow">Across every discipline</p><h2 class="section-title" id="governance-title">A system people can carry forward.</h2></div><div><p class="lead">Design governance connects the output to the team that will use it. Clear principles, reusable patterns, practical documentation, and review points help maintain coherence as a business changes.</p><div class="section-foot"><a class="text-link" href="/process">See the approach ↗</a></div></div></div></section>
  <ContactCTA />
</BaseLayout>
