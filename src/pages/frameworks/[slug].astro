---
import BaseLayout from '@layouts/BaseLayout.astro';
import RelatedContent from '@components/RelatedContent.astro';
import ContactCTA from '@components/ContactCTA.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('frameworks');
  return entries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article>
    <header class="framework-header container">
      <p class="t-label section-num">Framework</p>
      <div class="framework-title-grid">
        <h1 class="t-h1">{entry.data.title}</h1>
        <p class="t-large">{entry.data.summary}</p>
      </div>
      <dl class="framework-facts">
        <div>
          <dt class="t-label">Problem</dt>
          <dd class="t-body">{entry.data.problem}</dd>
        </div>
        <div>
          <dt class="t-label">Output</dt>
          <dd class="t-body">{entry.data.output}</dd>
        </div>
      </dl>
    </header>

    <hr />

    <div class="framework-body container">
      <section class="framework-system">
        <div>
          <p class="t-label">Inputs</p>
          <ul>
            {entry.data.inputs.map(item => <li class="t-body">{item}</li>)}
          </ul>
        </div>
        <div>
          <p class="t-label">Process</p>
          <ol>
            {entry.data.process.map(item => <li class="t-body">{item}</li>)}
          </ol>
        </div>
        <div>
          <p class="t-label">Example</p>
          <p class="t-body">{entry.data.example}</p>
        </div>
      </section>

      <div class="prose">
        <Content />
      </div>

      <RelatedContent title="Related Thinking" items={entry.data.relatedThinking ?? []} />
      <RelatedContent title="Related Work" items={entry.data.relatedWork ?? []} />
    </div>
  </article>
  <ContactCTA />
</BaseLayout>

<style>
  .framework-header {
    padding-block: var(--space-96) var(--space-48);
  }

  .framework-title-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.7fr);
    gap: var(--space-64);
    align-items: end;
    margin-top: var(--space-16);
  }

  .framework-title-grid h1 {
    max-width: 10ch;
  }

  .framework-title-grid p {
    color: var(--text-muted);
  }

  .framework-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin-top: var(--space-48);
    border-top: var(--border-width) solid var(--border);
    border-left: var(--border-width) solid var(--border);
  }

  .framework-facts div {
    padding: var(--space-card);
    border-right: var(--border-width) solid var(--border);
    border-bottom: var(--border-width) solid var(--border);
    background: var(--surface-elevated);
  }

  .framework-facts dt,
  .framework-facts dd {
    color: var(--text-muted);
  }

  .framework-facts dt {
    margin-bottom: var(--space-8);
  }

  .framework-body {
    padding-block: var(--space-64);
    display: flex;
    flex-direction: column;
    gap: var(--space-64);
  }

  .framework-system {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: var(--border-width) solid var(--border);
    border-left: var(--border-width) solid var(--border);
  }

  .framework-system > div {
    padding: var(--space-card);
    border-right: var(--border-width) solid var(--border);
    border-bottom: var(--border-width) solid var(--border);
  }

  .framework-system .t-label {
    margin-bottom: var(--space-16);
    color: var(--text-muted);
  }

  .framework-system li {
    padding-block: var(--space-8);
    border-top: var(--border-width) solid var(--border-subtle);
    color: var(--text-muted);
  }

  .framework-system p.t-body {
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .framework-title-grid,
    .framework-facts,
    .framework-system {
      grid-template-columns: 1fr;
    }
  }
</style>
