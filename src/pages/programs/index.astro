---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactCTA from '@components/ContactCTA.astro';
import { programs } from '../../data/site';
---
<BaseLayout title="Programs" description="HS108 programs for ongoing design direction, discovery, bespoke engagements, and design discourse.">
  <header class="page-hero shell"><p class="eyebrow">Ways to work together</p><h1 class="display">The relationship should fit the problem.</h1><p class="lead">Some challenges need a defined project. Others need discovery before a scope is clear, or design direction over time. These programs describe different ways to begin.</p></header>
  <section class="section shell" aria-labelledby="program-list-title"><div class="section-head"><p class="eyebrow">Programs</p><div><h2 class="section-title" id="program-list-title">Choose a useful starting point.</h2><p>Each engagement is shaped around the specific brief; these descriptions are introductions, not fixed packages or guaranteed terms.</p></div></div><div class="row-list">{programs.map((p,i) => <a href={p.href} class="row-link"><span class="row-num">0{i+1}</span><span class="row-title">{p.name}</span><span class="row-desc">{p.type}<br />{p.intro}</span><span class="row-arrow" aria-hidden="true">↗</span></a>)}</div></section>
  <ContactCTA />
</BaseLayout>
