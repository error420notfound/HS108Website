---
import BaseLayout from './BaseLayout.astro';
import ContactCTA from '@components/ContactCTA.astro';
import type { capabilities } from '../data/site';
type Capability = (typeof capabilities)[number];
interface Props { capability: Capability; }
const { capability: c } = Astro.props;
---
<BaseLayout title={c.name} description={`${c.name} at HS108. ${c.intro}`}>
  <header class="page-hero shell">
    <p class="eyebrow">Capability / {c.code}</p>
    <h1 class="display">{c.name}<span class="accent-dot">.</span></h1>
    <p class="lead">{c.intro}</p>
    <div class="hero-actions"><a class="button button--primary" href="/contact">Discuss a project ↗</a><a class="button button--secondary" href="/services">All capabilities</a></div>
  </header>
  <div class="shell detail-body">
    <div class="detail-lede"><p class="eyebrow">When this matters</p><p>{c.situation}</p></div>
    <section class="detail-section"><h2>Decisions we can help make</h2><p>{c.decisions}</p></section>
    <section class="detail-section"><h2>How it connects</h2><p>{c.connection}</p></section>
    <section class="detail-section"><h2>Possible outputs</h2><div><ul>{c.outputs.map(output => <li>{output}</li>)}</ul><p class="form-help" style="margin-top:20px">The exact scope is agreed after a conversation about the brief.</p></div></section>
    <div class="related-links"><a class="text-link" href="/process">See the approach ↗</a><a class="text-link" href="/work">Explore work ↗</a></div>
  </div>
  <ContactCTA />
</BaseLayout>
