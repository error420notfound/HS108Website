---
import BaseLayout from './BaseLayout.astro';
import ContactCTA from '@components/ContactCTA.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'work'>; }
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await entry.render();
const entries = (await getCollection('work', ({ data }) => !data.draft)).sort((a,b) => a.data.order-b.data.order);
const next = entries[(entries.findIndex(item => item.slug === entry.slug)+1)%entries.length];
---
<BaseLayout title={d.title} description={d.summary}>
  <header class="page-hero shell">
    <p class="eyebrow">Work / Studio archive</p>
    <h1 class="display">{d.title}<span class="accent-dot">.</span></h1>
    <p class="lead">{d.challenge}</p>
    <div class="hero-actions"><a class="button button--secondary" href="/work">All work</a></div>
  </header>
  <div class="shell detail-body">
    <div class="archive-notice" role="note"><span class="eyebrow">Content status</span><p>{d.verification}</p></div>
    {d.coverImage ? <figure class="case-cover"><img src={d.coverImage} alt={d.coverAlt ?? ''} width="1400" height="1050" decoding="async" /><figcaption>Existing archive artwork. Context pending confirmation.</figcaption></figure> : <div class="work-visual work-visual--missing case-cover"><span>{d.title}</span><small>Archive record / project artifacts pending confirmation</small></div>}
    <div class="detail-lede"><p class="detail-meta">{d.categories.join(' / ')}</p><p>{d.summary}</p></div>
    <section class="detail-section"><h2>Contribution in the archive</h2><p>{d.contribution}</p></section>
    <div class="case-prose prose"><Content /></div>
    {d.images && <div class="case-gallery">{d.images.map(img => <figure><img src={img.src} alt={img.alt} width="1000" height="750" loading="lazy" decoding="async" /><figcaption>{img.caption}</figcaption></figure>)}</div>}
    <div class="related-links"><a class="text-link" href={`/work/${next.slug}`}>Next archive record: {next.data.title} ↗</a><a class="text-link" href="/contact">Discuss a project ↗</a></div>
  </div>
  <ContactCTA headline="Have a challenge that crosses disciplines?" />
</BaseLayout>
