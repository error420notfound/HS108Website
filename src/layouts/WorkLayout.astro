---
import BaseLayout from './BaseLayout.astro';
import CaseStudyHeader from '@components/CaseStudyHeader.astro';
import SectionHeader from '@components/SectionHeader.astro';
import RelatedContent from '@components/RelatedContent.astro';
import ContactCTA from '@components/ContactCTA.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  client: string;
  year: number;
  categories: string[];
  tags: string[];
  coverImage: string;
  coverAlt: string;
  outcome: { label: string; value: string };
  summary: string;
  services: string[];
  duration?: string;
  slug: string;
  businessChallenge?: string;
  diagnosis?: string;
  constraints?: string[];
  strategicOpportunity?: string;
  intervention?: string;
  transferableInsight?: string;
  pullQuote?: string;
  stats?: { label: string; value: string }[];
  images?: { src: string; caption?: string }[];
  relatedFrameworks?: { label: string; title: string; href: string }[];
  relatedThinking?: { label: string; title: string; href: string }[];
}

const {
  title,
  client,
  year,
  categories,
  tags,
  coverImage,
  coverAlt,
  outcome,
  summary,
  services,
  duration,
  slug,
  businessChallenge,
  diagnosis,
  constraints = [],
  strategicOpportunity,
  intervention,
  transferableInsight,
  pullQuote,
  stats = [],
  images = [],
  relatedFrameworks = [],
  relatedThinking = [],
} = Astro.props;

const allWork = await getCollection('work', ({ data }) => !data.draft);
const sorted = allWork.sort((a, b) => a.data.order - b.data.order);
const currentIdx = sorted.findIndex(entry => entry.slug === slug);
const nextEntry = sorted[(currentIdx + 1) % sorted.length];

const meta = [
  { label: 'Services', value: services.join(', ') },
  { label: 'Categories', value: categories.map(c => c.replace('-', ' ')).join(', ') },
  { label: 'Methods', value: tags.slice(0, 4).join(', ') },
  { label: 'Outcome', value: `${outcome.label}: ${outcome.value}` },
  ...(duration ? [{ label: 'Duration', value: duration }] : []),
];
---

<BaseLayout title={`${title} — ${client}`} description={summary}>
  <CaseStudyHeader
    title={title}
    client={client}
    year={year}
    challenge={businessChallenge ?? summary}
    diagnosis={diagnosis ?? 'The project was structured around understanding the business problem before defining the design intervention.'}
    meta={meta}
  />

  {stats.length > 0 && (
    <section class="case-stats container">
      {stats.map(stat => (
        <div>
          <p class="t-label">{stat.label}</p>
          <strong>{stat.value}</strong>
        </div>
      ))}
    </section>
  )}

  <section class="section container">
    <div class="case-grid">
      <aside class="case-sidebar">
        <p class="t-label section-num">Project Logic</p>
        <ul>
          {['Context', 'Business Challenge', 'Diagnosis', 'Constraints', 'Strategic Opportunity', 'Design Intervention', 'Outcome', 'Transferable Insight'].map(item => (
            <li class="t-mono">{item}</li>
          ))}
        </ul>
      </aside>

      <div class="case-main">
        {pullQuote && <blockquote class="case-quote">{pullQuote}</blockquote>}

        <div class="case-panels">
          <article>
            <p class="t-label">Strategic Opportunity</p>
            <p class="t-body">{strategicOpportunity ?? 'The opportunity was to make the business value easier to understand and act on.'}</p>
          </article>
          <article>
            <p class="t-label">Design Intervention</p>
            <p class="t-body">{intervention ?? 'The intervention connected business diagnosis with a clearer design system.'}</p>
          </article>
          <article>
            <p class="t-label">Transferable Insight</p>
            <p class="t-body">{transferableInsight ?? 'The useful lesson is in the decision logic, not only the final output.'}</p>
          </article>
        </div>

        {constraints.length > 0 && (
          <section class="case-constraints">
            <p class="t-label">Constraints</p>
            <ul>
              {constraints.map(item => <li class="t-body">{item}</li>)}
            </ul>
          </section>
        )}

        <div class="prose">
          <slot />
        </div>

        <figure class="case-cover">
          <img src={coverImage} alt={coverAlt} loading="lazy" />
          <figcaption class="t-label">Execution evidence</figcaption>
        </figure>

        {images.length > 0 && (
          <section class="case-gallery">
            <SectionHeader label="Evidence" title="Supporting execution details." />
            {images.map(image => (
              <figure>
                <img src={image.src} alt={image.caption ?? ''} loading="lazy" />
                {image.caption && <figcaption class="t-label">{image.caption}</figcaption>}
              </figure>
            ))}
          </section>
        )}

        <RelatedContent title="Related Frameworks" items={relatedFrameworks} />
        <RelatedContent title="Related Thinking" items={relatedThinking} />
      </div>
    </div>
  </section>

  {nextEntry && (
    <section class="next-work container">
      <p class="t-label section-num">Next Project</p>
      <a href={`/work/${nextEntry.slug}`}>
        <span class="t-h3">{nextEntry.data.title}</span>
        <span class="t-label">View The Diagnosis</span>
      </a>
    </section>
  )}

  <ContactCTA />
</BaseLayout>

<style>
  .case-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: var(--border-width) solid var(--border);
    border-left: var(--border-width) solid var(--border);
    margin-bottom: var(--space-32);
  }

  .case-stats div {
    padding: var(--space-card);
    border-right: var(--border-width) solid var(--border);
    border-bottom: var(--border-width) solid var(--border);
  }

  .case-stats p {
    color: var(--text-muted);
    margin-bottom: var(--space-8);
  }

  .case-stats strong {
    font-family: var(--font-display);
    font-size: var(--size-h2);
    font-weight: 400;
  }

  .case-grid {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: var(--space-64);
    align-items: start;
  }

  .case-sidebar {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-24));
    border-top: var(--border-width) solid var(--border);
    padding-top: var(--space-16);
  }

  .case-sidebar ul {
    margin-top: var(--space-16);
    display: grid;
    gap: var(--space-8);
    color: var(--text-muted);
  }

  .case-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
  }

  .case-quote {
    font-family: var(--font-display);
    font-size: var(--size-h2);
    line-height: 1.18;
    border-left: var(--border-width) solid var(--border);
    padding-left: var(--space-24);
  }

  .case-panels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: var(--border-width) solid var(--border);
    border-left: var(--border-width) solid var(--border);
  }

  .case-panels article {
    padding: var(--space-card);
    border-right: var(--border-width) solid var(--border);
    border-bottom: var(--border-width) solid var(--border);
    background: var(--surface-elevated);
  }

  .case-panels .t-label,
  .case-panels p,
  .case-constraints .t-label,
  .case-constraints li {
    color: var(--text-muted);
  }

  .case-panels .t-label {
    margin-bottom: var(--space-12);
  }

  .case-constraints {
    padding: var(--space-card);
    border: var(--border-width) solid var(--border);
  }

  .case-constraints ul {
    margin-top: var(--space-16);
    display: grid;
    gap: var(--space-12);
  }

  .case-cover,
  .case-gallery figure {
    border: var(--border-width) solid var(--border);
  }

  .case-cover img,
  .case-gallery img {
    width: 100%;
    height: auto;
    border-bottom: var(--border-width) solid var(--border);
  }

  .case-cover figcaption,
  .case-gallery figcaption {
    padding: var(--space-12);
    color: var(--text-muted);
  }

  .case-gallery {
    display: grid;
    gap: var(--space-24);
  }

  .next-work {
    padding-block: var(--space-48);
  }

  .next-work > p {
    margin-bottom: var(--space-16);
  }

  .next-work a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-24);
    padding-block: var(--space-24);
    border-top: var(--border-width) solid var(--border);
    border-bottom: var(--border-width) solid var(--border);
  }

  .next-work a:hover {
    background: var(--surface-muted);
  }

  @media (max-width: 1000px) {
    .case-grid,
    .case-panels,
    .case-stats {
      grid-template-columns: 1fr;
    }

    .case-sidebar {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .next-work a {
      flex-direction: column;
    }
  }
</style>
