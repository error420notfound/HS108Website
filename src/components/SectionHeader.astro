---
interface Props {
  label?: string;
  title: string;
  intro?: string;
}

const { label, title, intro } = Astro.props;
---

<header class="section-header">
  <div class="section-header-main">
    {label && <p class="t-label section-num">{label}</p>}
    <h2 class="t-h2">{title}</h2>
  </div>
  {intro && <p class="t-body section-header-intro">{intro}</p>}
</header>

<style>
  .section-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.8fr);
    gap: var(--space-48);
    align-items: end;
    padding-bottom: var(--space-24);
    margin-bottom: var(--space-32);
    border-bottom: var(--border-width) solid var(--border);
  }

  .section-header-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .section-header-intro {
    color: var(--text-muted);
    max-width: 54ch;
  }

  @media (max-width: 800px) {
    .section-header {
      grid-template-columns: 1fr;
      gap: var(--space-16);
      align-items: start;
    }
  }
</style>
