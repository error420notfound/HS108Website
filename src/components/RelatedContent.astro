---
interface Item {
  label: string;
  title: string;
  href: string;
}

interface Props {
  title?: string;
  items: Item[];
}

const { title = 'Related Thinking', items } = Astro.props;
---

{items.length > 0 && (
  <section class="related">
    <p class="t-label section-num">{title}</p>
    <div class="related-list">
      {items.map(item => (
        <a href={item.href} class="related-link">
          <span class="t-label">{item.label}</span>
          <span>{item.title}</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related {
    padding-top: var(--space-48);
    border-top: var(--border-width) solid var(--border);
  }

  .related > .t-label {
    margin-bottom: var(--space-16);
  }

  .related-list {
    display: grid;
    gap: 0;
    border-top: var(--border-width) solid var(--border);
  }

  .related-link {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: var(--space-24);
    padding-block: var(--space-16);
    border-bottom: var(--border-width) solid var(--border);
  }

  .related-link:hover span:last-child {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .related-link .t-label {
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .related-link {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
