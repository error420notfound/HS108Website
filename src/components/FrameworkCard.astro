---
interface Props {
  title: string;
  helps: string;
  applies: string;
  href: string;
}

const { title, helps, applies, href } = Astro.props;
---

<a href={href} class="framework-card">
  <p class="t-label">Framework</p>
  <h3 class="t-h3">{title}</h3>
  <dl class="framework-meta">
    <div>
      <dt class="t-label">Helps Decide</dt>
      <dd class="t-body">{helps}</dd>
    </div>
    <div>
      <dt class="t-label">Applies When</dt>
      <dd class="t-body">{applies}</dd>
    </div>
  </dl>
  <span class="t-label framework-link">Read The Framework</span>
</a>

<style>
  .framework-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    min-height: 100%;
    padding: var(--space-card);
    border: var(--border-width) solid var(--border);
    background: var(--surface-elevated);
    transition: background var(--duration-fast) var(--ease-standard);
  }

  .framework-card:hover {
    background: var(--surface-muted);
  }

  .framework-card > .t-label,
  .framework-meta dt,
  .framework-meta dd {
    color: var(--text-muted);
  }

  .framework-meta {
    display: grid;
    gap: var(--space-16);
  }

  .framework-meta div {
    padding-top: var(--space-16);
    border-top: var(--border-width) solid var(--border-subtle);
  }

  .framework-meta dt {
    margin-bottom: var(--space-6);
  }

  .framework-link {
    margin-top: auto;
  }
</style>
