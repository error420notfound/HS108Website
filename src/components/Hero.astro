---
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-meta">
      <span class="t-label">HS108</span>
      <span class="t-label">Design Practice</span>
      <span class="t-label">Business Before Deliverables</span>
    </div>

    <div class="hero-grid">
      <h1 class="t-hero">Design for better business decisions.</h1>
      <div class="hero-copy">
        <p class="t-large">
          HS108 helps founders understand what is really blocking growth, trust, clarity, or conversion, then uses design to make the right decision visible.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn--primary">Start A Project Conversation</a>
          <a href="/thinking" class="btn btn--outline">See How We Think</a>
        </div>
      </div>
    </div>

    <div class="hero-system" aria-label="HS108 working model">
      {['Problem', 'Diagnosis', 'System', 'Decision', 'Design', 'Outcome'].map(item => (
        <span class="t-label">{item}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    border-bottom: var(--border-width) solid var(--border);
    background: var(--surface-base);
  }

  .hero-inner {
    padding-block: var(--space-96) var(--space-64);
  }

  .hero-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-16);
    flex-wrap: wrap;
    padding-block: var(--space-12);
    margin-bottom: var(--space-64);
    border-top: var(--border-width) solid var(--border);
    border-bottom: var(--border-width) solid var(--border);
    color: var(--text-muted);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.55fr);
    gap: var(--space-64);
    align-items: end;
  }

  .hero h1 {
    max-width: 11ch;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .hero-copy p {
    color: var(--text-muted);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-12);
    flex-wrap: wrap;
  }

  .hero-system {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin-top: var(--space-64);
    border-top: var(--border-width) solid var(--border);
    border-left: var(--border-width) solid var(--border);
  }

  .hero-system span {
    padding: var(--space-16);
    border-right: var(--border-width) solid var(--border);
    border-bottom: var(--border-width) solid var(--border);
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .hero-grid,
    .hero-system {
      grid-template-columns: 1fr;
    }

    .hero h1 {
      max-width: 12ch;
    }
  }
</style>
