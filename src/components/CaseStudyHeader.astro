---
interface MetaItem {
  label: string;
  value: string | number;
}

interface Props {
  title: string;
  client: string;
  year: number;
  challenge: string;
  diagnosis: string;
  meta: MetaItem[];
}

const { title, client, year, challenge, diagnosis, meta } = Astro.props;
---

<header class="case-header container">
  <div class="case-kicker">
    <span class="t-label">{client}</span>
    <span class="t-label">{year}</span>
  </div>
  <div class="case-title-grid">
    <div>
      <p class="t-label section-num">Project Evidence</p>
      <h1 class="t-h1">{title}</h1>
    </div>
    <div class="case-diagnosis">
      <p class="t-label">Business Challenge</p>
      <p class="t-large">{challenge}</p>
      <p class="t-label">Diagnosis</p>
      <p class="t-body">{diagnosis}</p>
    </div>
  </div>
  <dl class="case-meta">
    {meta.map(item => (
      <div>
        <dt class="t-label">{item.label}</dt>
        <dd class="t-mono">{item.value}</dd>
      </div>
    ))}
  </dl>
</header>

<style>
  .case-header {
    padding-block: var(--space-96) var(--space-48);
  }

  .case-kicker {
    display: flex;
    justify-content: space-between;
    gap: var(--space-24);
    padding-block: var(--space-12);
    margin-bottom: var(--space-48);
    border-top: var(--border-width) solid var(--border);
    border-bottom: var(--border-width) solid var(--border);
    color: var(--text-muted);
  }

  .case-title-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.7fr);
    gap: var(--space-64);
    align-items: start;
  }

  .case-title-grid h1 {
    margin-top: var(--space-12);
    max-width: 12ch;
  }

  .case-diagnosis {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding: var(--space-card);
    border: var(--border-width) solid var(--border);
    background: var(--surface-elevated);
  }

  .case-diagnosis .t-label,
  .case-diagnosis .t-body {
    color: var(--text-muted);
  }

  .case-meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: var(--space-48);
    border-top: var(--border-width) solid var(--border);
    border-left: var(--border-width) solid var(--border);
  }

  .case-meta div {
    padding: var(--space-16);
    border-right: var(--border-width) solid var(--border);
    border-bottom: var(--border-width) solid var(--border);
  }

  .case-meta dt {
    margin-bottom: var(--space-8);
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .case-title-grid,
    .case-meta {
      grid-template-columns: 1fr;
    }
  }
</style>
