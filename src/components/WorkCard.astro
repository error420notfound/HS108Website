---
interface Props {
  slug: string;
  title: string;
  client: string;
  year: number;
  categories: string[];
  summary: string;
  outcome: { label: string; value: string };
  businessChallenge?: string;
  diagnosis?: string;
  coverImage?: string;
  coverAlt?: string;
  large?: boolean;
}

const {
  slug,
  title,
  client,
  year,
  categories,
  summary,
  outcome,
  businessChallenge,
  diagnosis,
  coverImage,
  coverAlt,
  large = false,
} = Astro.props;
---

<a href={`/work/${slug}`} class:list={['work-card', { 'work-card--large': large }]}>
  <div class="work-card-body">
    <div class="work-card-meta">
      <span class="t-label">{client}</span>
      <span class="t-label">{year}</span>
    </div>
    <h3 class:list={[large ? 't-h2' : 't-h3']}>{title}</h3>
    <p class="t-body work-card-summary">{businessChallenge ?? summary}</p>
    {diagnosis && (
      <div class="work-card-diagnosis">
        <span class="t-label">Diagnosis</span>
        <p class="t-body">{diagnosis}</p>
      </div>
    )}
    <div class="work-card-footer">
      <div class="work-card-tags">
        {categories.slice(0, 3).map(category => <span class="tag">{category.replace('-', ' ')}</span>)}
      </div>
      <div class="work-card-outcome">
        <span class="t-label">{outcome.label}</span>
        <strong>{outcome.value}</strong>
      </div>
    </div>
    <span class="t-label work-card-link">View The Diagnosis</span>
  </div>
  {coverImage && (
    <figure class="work-card-evidence">
      <img src={coverImage} alt={coverAlt ?? ''} loading="lazy" />
      <figcaption class="t-label">Execution Evidence</figcaption>
    </figure>
  )}
</a>

<style>
  .work-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: 100%;
    border: var(--border-width) solid var(--border);
    background: var(--surface-elevated);
    transition: background var(--duration-fast) var(--ease-standard);
  }

  .work-card--large {
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.55fr);
  }

  .work-card:hover {
    background: var(--surface-muted);
  }

  .work-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding: var(--space-card);
  }

  .work-card-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-16);
    color: var(--text-muted);
  }

  .work-card-summary,
  .work-card-diagnosis p,
  .work-card-outcome span {
    color: var(--text-muted);
  }

  .work-card-diagnosis {
    padding-top: var(--space-16);
    border-top: var(--border-width) solid var(--border-subtle);
  }

  .work-card-diagnosis .t-label {
    display: block;
    margin-bottom: var(--space-8);
    color: var(--text-muted);
  }

  .work-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-24);
    margin-top: auto;
    padding-top: var(--space-16);
    border-top: var(--border-width) solid var(--border);
  }

  .work-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .work-card-outcome {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-4);
    text-align: right;
  }

  .work-card-outcome strong {
    font-family: var(--font-display);
    font-size: var(--size-h3);
    font-weight: 400;
    line-height: 1;
  }

  .work-card-link {
    margin-top: var(--space-16);
  }

  .work-card-evidence {
    border-left: var(--border-width) solid var(--border);
    min-height: 100%;
    display: flex;
    flex-direction: column;
  }

  .work-card-evidence img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-bottom: var(--border-width) solid var(--border);
  }

  .work-card-evidence figcaption {
    padding: var(--space-12);
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .work-card--large {
      grid-template-columns: 1fr;
    }

    .work-card-evidence {
      border-left: 0;
      border-top: var(--border-width) solid var(--border);
    }
  }
</style>
