---
interface Item {
  symptom: string;
  cause: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="problem-list">
  {items.map((item, index) => (
    <article class="problem-row">
      <span class="t-label problem-index">{String(index + 1).padStart(2, '0')}</span>
      <h3 class="t-h3">{item.symptom}</h3>
      <p class="t-body">{item.cause}</p>
    </article>
  ))}
</div>

<style>
  .problem-list {
    border-top: var(--border-width) solid var(--border);
  }

  .problem-row {
    display: grid;
    grid-template-columns: 80px minmax(220px, 0.8fr) minmax(0, 1fr);
    gap: var(--space-24);
    padding-block: var(--space-24);
    border-bottom: var(--border-width) solid var(--border);
  }

  .problem-index,
  .problem-row p {
    color: var(--text-muted);
  }

  @media (max-width: 800px) {
    .problem-row {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
  }
</style>
