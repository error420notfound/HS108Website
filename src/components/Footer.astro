---
const year = new Date().getFullYear();

const primaryLinks = [
  { label: 'Studio', href: '/studio' },
  { label: 'Work', href: '/work' },
  { label: 'Thinking', href: '/thinking' },
  { label: 'Services', href: '/services' },
  { label: 'Contact', href: '/contact' },
];

const systemLinks = [
  { label: 'Frameworks', href: '/frameworks', note: 'Decision systems' },
  { label: 'SIAM', href: '/frameworks/siam', note: 'Symptom to intervention' },
  { label: 'Design Governance', href: '/frameworks/design-governance', note: 'Keep decisions coherent' },
];
---

<footer class="footer">
  <div class="container footer-main">
    <div class="footer-positioning">
      <a href="/" class="footer-logo" aria-label="HS108 Home">
        <img src="/logo.svg" alt="HS108" class="footer-logo-image" />
      </a>
      <p class="footer-line">
        HS108 helps founders understand business problems and use design as a tool for better decisions.
      </p>
      <a href="mailto:contact.studio@hs108.in" class="footer-email link-swap">contact.studio@hs108.in</a>
    </div>

    <div class="footer-columns">
      <div class="footer-col">
        <p class="t-label footer-label">Site</p>
        <ul role="list">
          {primaryLinks.map(link => (
            <li><a href={link.href} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <p class="t-label footer-label">Thinking Systems</p>
        <ul role="list">
          {systemLinks.map(link => (
            <li>
              <a href={link.href} class="footer-link footer-link--stacked">
                <span>{link.label}</span>
                <span>{link.note}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <p class="t-label footer-label">Studio Status</p>
        <p class="t-mono footer-note">Available for selected founder-led projects.</p>
        <p class="t-mono footer-note">Based in India. Working with teams worldwide.</p>
      </div>
    </div>
  </div>

  <div class="container footer-bar">
    <p class="t-mono">&copy; {year} HS108.</p>
    <p class="t-mono">Designed and built in-house.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--border-width) solid var(--border);
    background: var(--surface-elevated);
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) 2fr;
    gap: var(--space-64);
    padding-block: var(--space-64);
    border-bottom: var(--border-width) solid var(--border);
  }

  .footer-positioning {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .footer-logo {
    width: fit-content;
  }

  .footer-logo-image {
    width: auto;
    height: 38px;
  }

  .footer-line {
    max-width: 36ch;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .footer-email {
    font-family: var(--font-mono);
    font-size: var(--size-small);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-32);
  }

  .footer-label {
    margin-bottom: var(--space-16);
    color: var(--text-muted);
  }

  .footer-link {
    min-height: 32px;
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--size-small);
  }

  .footer-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer-link--stacked {
    align-items: flex-start;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-6);
  }

  .footer-link--stacked span:last-child,
  .footer-note {
    color: var(--text-muted);
  }

  .footer-note + .footer-note {
    margin-top: var(--space-12);
  }

  .footer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    padding-block: var(--space-16);
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .footer-main,
    .footer-columns {
      grid-template-columns: 1fr;
    }

    .footer-main {
      gap: var(--space-48);
    }
  }

  @media (max-width: 640px) {
    .footer-bar {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
