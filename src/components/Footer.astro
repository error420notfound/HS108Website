---
const year = new Date().getFullYear();
const nav = [
  ['Work', '/work'], ['Capabilities', '/services'], ['Approach', '/process'],
  ['Studio', '/about'], ['Field Notes', '/programs/field-notes'], ['Contact', '/contact'],
];
const programs = [
  ['Creative Department', '/programs/creative-department'],
  ['Design Lab', '/programs/design-lab'],
  ['off_menu', '/programs/off-menu'],
];
---
<footer class="site-footer">
  <div class="shell footer-main">
    <div class="footer-intro">
      <a href="/" class="footer-logo" aria-label="HS108 home"><img src="/logo.svg" width="168" height="50" alt="HS108" loading="lazy" /></a>
      <p>Independent design studio<br />based in India.</p>
      <a class="text-link" href="mailto:contact.studio@hs108.in">contact.studio@hs108.in ↗</a>
    </div>
    <nav aria-label="Footer navigation"><p class="eyebrow">Explore</p>{nav.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
    <nav aria-label="Programs"><p class="eyebrow">Programs</p>{programs.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
    <div class="footer-note"><p class="eyebrow">HS108</p><p>Brand, product, and digital decisions considered together.</p><a class="text-link" href="/why-us">Why work with us ↗</a></div>
  </div>
  <div class="shell footer-bottom"><span>© {year} HS108 Design Studio</span><span>Independent · Based in India</span></div>
</footer>
