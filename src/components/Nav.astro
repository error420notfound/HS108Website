---
const links = [
  { label: 'Studio', href: '/studio', active: ['/studio', '/about'] },
  { label: 'Work', href: '/work', active: ['/work'] },
  { label: 'Thinking', href: '/thinking', active: ['/thinking', '/frameworks'] },
  { label: 'Services', href: '/services', active: ['/services'] },
  { label: 'Contact', href: '/contact', active: ['/contact'] },
];

const currentPath = Astro.url.pathname;
const isActive = (link: { active: string[] }) => link.active.some(path => currentPath === path || currentPath.startsWith(`${path}/`));
---

<header class="nav-wrap">
  <nav class="nav container" aria-label="Primary navigation">
    <a href="/" class="nav-logo" aria-label="HS108 Home">
      <img src="/logo.svg" alt="HS108" class="nav-logo-image" />
    </a>

    <ul class="nav-links" role="list">
      {links.map(link => (
        <li>
          <a href={link.href} class:list={['nav-link', { active: isActive(link) }]}>{link.label}</a>
        </li>
      ))}
    </ul>

    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="nav-mobile"
    >
      <span></span>
      <span></span>
    </button>
  </nav>

  <div class="nav-mobile" id="nav-mobile" hidden>
    <div class="container nav-mobile-inner">
      {links.map(link => (
        <a href={link.href} class:list={['nav-mobile-link', { active: isActive(link) }]}>{link.label}</a>
      ))}
    </div>
  </div>
</header>

<style>
  .nav-wrap {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    background: var(--bg);
    border-bottom: var(--border-width) solid var(--border);
  }

  .nav {
    height: var(--nav-height);
    display: flex;
    align-items: center;
    gap: var(--space-24);
  }

  .nav-logo {
    display: inline-flex;
    align-items: center;
    margin-right: auto;
  }

  .nav-logo-image {
    width: auto;
    height: 38px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-8) var(--space-12);
    font-family: var(--font-mono);
    font-size: var(--size-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: background var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--fg);
    background: var(--surface-muted);
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: var(--border-width) solid var(--border);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: var(--space-6);
  }

  .nav-toggle span {
    display: block;
    width: 18px;
    height: 1px;
    background: var(--fg);
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .nav-toggle[aria-expanded="true"] span:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  .nav-mobile {
    border-top: var(--border-width) solid var(--border);
    background: var(--bg);
  }

  .nav-mobile-inner {
    display: grid;
    padding-block: var(--space-16);
  }

  .nav-mobile-link {
    min-height: 48px;
    display: flex;
    align-items: center;
    border-bottom: var(--border-width) solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: var(--size-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .nav-mobile-link.active,
  .nav-mobile-link:hover {
    color: var(--fg);
  }

  @media (max-width: 800px) {
    .nav-links {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('nav-mobile') as HTMLElement | null;

  toggle?.addEventListener('click', () => {
    if (!menu) return;
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Open navigation' : 'Close navigation');
    menu.hidden = isOpen;
    document.body.classList.toggle('nav-open', !isOpen);
  });

  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (!toggle || !menu) return;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation');
      menu.hidden = true;
      document.body.classList.remove('nav-open');
    });
  });
</script>
