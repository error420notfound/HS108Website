---
const path = Astro.url.pathname;
const links = [
  { label: 'Work', href: '/work', match: '/work' },
  { label: 'Capabilities', href: '/services', match: '/services' },
  { label: 'Approach', href: '/process', match: '/process' },
  { label: 'Studio', href: '/about', match: '/about' },
  { label: 'Field Notes', href: '/programs/field-notes', match: '/programs/field-notes' },
];
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/" aria-label="HS108 home"><img src="/logo.svg" width="168" height="50" alt="HS108" /></a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map(link => <a href={link.href} aria-current={path.startsWith(link.match) ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <a class="button button--primary header-cta" href="/contact">Start a project <span aria-hidden="true">↗</span></a>
    <details class="mobile-nav">
      <summary>Menu <span class="menu-mark" aria-hidden="true">+</span></summary>
      <nav aria-label="Mobile navigation">
        {links.map(link => <a href={link.href} aria-current={path.startsWith(link.match) ? 'page' : undefined}>{link.label}</a>)}
        <a href="/programs">Programs</a>
        <a href="/contact">Start a project ↗</a>
      </nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  if (menu) {
    const toggle = menu.querySelector<HTMLElement>('summary');
    menu.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        toggle?.focus();
      }
    });
    document.addEventListener('pointerdown', event => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  }
</script>
