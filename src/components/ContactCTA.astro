---
interface Props { headline?: string; sub?: string; invert?: boolean; domain?: string; }
const { headline = 'Start with the problem.', sub = 'Tell us what you are building, changing, or trying to make clearer. We will take the conversation from there.', invert = false } = Astro.props;
---
<section class:list={['contact-band', { 'contact-band--dark': invert }]} aria-labelledby="contact-band-title">
  <div class="shell contact-band-inner">
    <div><p class="eyebrow">Start a project</p><h2 id="contact-band-title">{headline}</h2></div>
    <div><p>{sub}</p><a class="button button--primary" href="/contact">Discuss a project <span aria-hidden="true">↗</span></a></div>
  </div>
</section>
