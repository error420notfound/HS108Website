---
interface Props {
  headline?: string;
  sub?: string;
  invert?: boolean;
  domain?: string;
}

const {
  headline = 'Start with the business problem.',
  sub = 'Share what feels unclear. HS108 will respond with the next useful step, not a generic pitch.',
  invert = true,
  domain,
} = Astro.props;

const ctaHref = domain ? `/contact?domain=${domain}` : '/contact';
---

<section class:list={['cta-section', { 'section--inv': invert }]}>
  <div class="container cta-inner">
    <div class="cta-copy">
      <p class="t-label section-num">Conversation</p>
      <h2 class="t-h1">{headline}</h2>
      <p class="t-body cta-sub">{sub}</p>
    </div>
    <div class="cta-actions">
      <a href={ctaHref} class:list={['btn', invert ? 'btn--outline-inv' : 'btn--primary']}>Start A Project Conversation</a>
      <a href="mailto:contact.studio@hs108.in" class:list={['btn', invert ? 'btn--outline-inv' : 'btn--outline']}>Email Project Context</a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    border-top: var(--border-width) solid var(--border);
  }

  .section--inv {
    border-top-color: var(--border-inv);
  }

  .cta-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-48);
    align-items: end;
    padding-block: var(--space-section);
  }

  .cta-copy {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .cta-sub {
    max-width: 58ch;
    color: currentColor;
    opacity: 0.72;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  @media (max-width: 900px) {
    .cta-inner {
      grid-template-columns: 1fr;
    }

    .cta-actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
